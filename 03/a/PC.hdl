// File name: projects/03/a/PC.hdl

/**
 * A 16-bit counter with load and reset control bits.
 * if      (reset[t] == 1) out[t+1] = 0
 * else if (load[t] == 1)  out[t+1] = in[t]
 * else if (inc[t] == 1)   out[t+1] = out[t] + 1  (integer addition)
 * else                    out[t+1] = out[t]
 */

CHIP PC {
    IN in[16],load,inc,reset;
    OUT out[16];

    PARTS:
    // Put your code here:
    // 1. 計算遞增值 (out[t] + 1)
    Inc16(in=regOut, out=incOut);

    // 2. 依據 inc 控制訊號選擇：遞增值 或 原值
    Mux16(a=regOut, b=incOut, sel=inc, out=outInc);

    // 3. 依據 load 控制訊號選擇：輸入值 (in) 或 上一步結果 (優先權高於 inc)
    Mux16(a=outInc, b=in, sel=load, out=outLoad);

    // 4. 依據 reset 控制訊號選擇：0 (false) 或 上一步結果 (最高優先權)
    Mux16(a=outLoad, b=false, sel=reset, out=outReset);

    // 5. 將最終數值存入 Register 暫存器
    // load設為true代表每個時鐘週期都更新暫存器狀態
    Register(in=outReset, load=true, out=out, out=regOut);
}
